{
  "schemaVersion": 1,
  "id": "glorious_animations",
  "version": "${version}",

  "name": "Glorious Animations",
  "description": "This mod adds cool animations to the player.",
  "authors": [
    "GekidoLukas",
    "onemeyn",
    "McVader"
  ],
  "contact": {
    "homepage": "https://modrinth.com/user/GekidoLukas",
    "sources": "https://github.com/GekidoLukas/Glorious-Animations"
  },

  "license": "MIT",
  "icon": "assets/glorious_animations/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "net.gekidolukas.glorious_animations.GloriousAnimations"
    ],
    "client": [
      "net.gekidolukas.glorious_animations.GloriousAnimations"
    ],
    "modmenu": [
      "net.gekidolukas.glorious_animations.config.ModMenuConfig"
    ]
  },
  "mixins": [
    "glorious_animations.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "minecraft": ">=1.21.1",
    "java": ">=21",
    "player-animator": ">=0.3"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/network/AbstractClientPlayerEntity": ["net/gekidolukas/glorious_animations/interfaces/TorsoPosGetter"],

      "net/minecraft/entity/player/PlayerEntity": ["net/gekidolukas/glorious_animations/interfaces/SwingTypeGetter"]
      },
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/Z6jJFxZAUS"
      }
    }
  }
}
